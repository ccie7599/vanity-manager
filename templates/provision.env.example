# Vanity Manager — provision.env template.
#
# Copy to `provision.env` at the repo root and fill in your values:
#   cp templates/provision.env.example provision.env
# DO NOT commit provision.env — it's gitignored. Treat every value as a secret.
#
# `make provision` can auto-generate this file, but ONLY when you're deploying
# into the SAME Linode + Akamai account your local CLIs are authenticated
# against — it creates a Linode bucket and an EdgeKV namespace for you. If you
# are deploying into a different/customer tenant, DO NOT run `make provision`;
# fill this file in by hand from that account's resources.
#
# All values are sourced as env vars by the Makefile and passed to
# `spin aka deploy` as Spin variables.

# ----- Admin token --------------------------------------------------------
# Bearer token for the admin API + UI. Generate fresh: `openssl rand -hex 32`.
ADMIN_TOKEN=

# ----- Akamai EdgeGrid credentials (required) ----------------------------
# From your `.edgerc`. The API client needs Property Manager (PAPI) + EdgeKV
# + EdgeWorkers grants so the platform can push redirect data into EdgeKV.
AKAMAI_HOST=
AKAMAI_CLIENT_TOKEN=
AKAMAI_CLIENT_SECRET=
AKAMAI_ACCESS_TOKEN=

# ----- EdgeKV addressing (required) --------------------------------------
# The namespace + group must already exist in your account, and the namespace
# string must be IDENTICAL to the one baked into the EdgeWorker bundle
# (EW_NAMESPACE at build time) — the Function writes it, the EW reads it.
EKV_NETWORK=staging          # `staging` or `production`
EKV_NAMESPACE=vanity-manager
EKV_GROUP=redirects

# ----- EdgeWorker ID (required for `make ew-deploy-*`) -------------------
# The EdgeWorker ID you created in Control Center. scripts/ew-deploy.sh reads
# it from here.
EW_ID=

# ----- Object Storage (optional) -----------------------------------------
# S3-compatible snapshot + cold-start seed. Best-effort: leave blank to run
# without it (rules still flow through Spin KV + EdgeKV). Fill in only if you
# want a durable catalog snapshot.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SNAPSHOT_PREFIX=catalog

# ----- NATS KV backend (optional) ----------------------------------------
# For higher rule counts past Spin KV's get_keys() 30s cap. See DECISIONS.md
# ADR-011. Leave blank for the default Spin KV backend.
KV_BACKEND=
KV_NATS_BUCKET=
KV_NATS_TOKEN=
